# Test 4: Repository dispatch validation - valid and invalid bodies
# Use gh as a credential helper
exec gh auth setup-git

# Create a repository with a file so it has a default branch
exec gh repo create $ORG/$SCRIPT_NAME-$RANDOM_STRING --add-readme --private

# Defer repo cleanup
defer gh repo delete --yes $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Clone the repo
exec gh repo clone $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Commit the workflow file
cd $SCRIPT_NAME-$RANDOM_STRING
exec git config user.email "test@example.com"
exec git config user.name "Test User"
mkdir .github/workflows
mv ../workflow.yml .github/workflows/workflow.yml
exec git add .github/workflows/workflow.yml
exec git commit -m 'Create workflow file'
exec git push -u origin main

# Sleep because it takes a second for the workflow to register
sleep 1

# Get initial run count
exec gh run list --json databaseId --jq 'length'
stdout2env INITIAL_RUN_COUNT

# Test 4a: Valid repository dispatch with event_type - should succeed
exec gh api --method POST /repos/$ORG/$SCRIPT_NAME-$RANDOM_STRING/dispatches -f event_type=test_event -f client_payload[key]=value
# Should return 204 No Content (empty output is expected)

# Wait a moment
sleep 2

# Verify no workflow run was created (repository_dispatch doesn't create runs without workflow listening)
exec gh run list --json databaseId --jq 'length'
stdout2env AFTER_VALID_COUNT

# Verify run count hasn't changed (no workflow listening to repository_dispatch)
exec test "$INITIAL_RUN_COUNT" = "$AFTER_VALID_COUNT"

# Test 4b: Invalid repository dispatch - missing event_type - should fail
! exec gh api --method POST /repos/$ORG/$SCRIPT_NAME-$RANDOM_STRING/dispatches -f client_payload[key]=value
stderr '(event_type|required)'

# Wait to ensure no side effects
sleep 2

# Verify still no runs created
exec gh run list --json databaseId --jq 'length'
stdout2env FINAL_RUN_COUNT

# Verify run count hasn't changed
exec test "$INITIAL_RUN_COUNT" = "$FINAL_RUN_COUNT"

# Test 4c: Invalid repository dispatch - malformed body - should fail
! exec gh api --method POST /repos/$ORG/$SCRIPT_NAME-$RANDOM_STRING/dispatches -H 'Content-Type: application/json' --input /dev/null
stderr '(Invalid request body|parse|invalid|required)'

# Final verification - no unexpected workflow runs
exec gh run list --json databaseId --jq 'length'
stdout2env FINAL_CHECK_COUNT

exec test "$INITIAL_RUN_COUNT" = "$FINAL_CHECK_COUNT"

-- workflow.yml --
# This is a basic workflow to help you get started with Actions

name: Test Workflow Name

# Controls when the workflow will run
on:
  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

# A workflow run is made up of one or more jobs that can run sequentially or in parallel
jobs:
  # This workflow contains a single job called "build"
  build:
    # The type of runner that the job will run on
    runs-on: ubuntu-latest

    # Steps represent a sequence of tasks that will be executed as part of the job
    steps:
      # Checks-out your repository under $GITHUB_WORKSPACE, so your job can access it
      - uses: actions/checkout@v4

      # Runs a single command using the runners shell
      - name: Run a one-line script
        run: echo Hello, world!
