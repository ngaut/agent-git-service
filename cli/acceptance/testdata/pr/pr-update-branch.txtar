# Use gh as a credential helper
exec gh auth setup-git

# Create a repository with a file so it has a default branch
exec gh repo create $ORG/$SCRIPT_NAME-$RANDOM_STRING --add-readme --private

# Defer repo cleanup
defer gh repo delete --yes $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Clone the repo
exec gh repo clone $ORG/$SCRIPT_NAME-$RANDOM_STRING
cd $SCRIPT_NAME-$RANDOM_STRING
exec git config user.email "test@example.com"
exec git config user.name "Test User"

# Create a feature branch with a change
exec git checkout -b feature-branch
mv ../feature.txt feature.txt
exec git add .
exec git commit -m 'Add feature file'
exec git push -u origin feature-branch

# Create a PR
exec gh pr create --title 'Feature PR' --body 'Needs branch update'
stdout2env PR_URL

# Go back to main and add a commit
exec git checkout main
mv ../base-change.txt base-change.txt
exec git add .
exec git commit -m 'Add base change'
exec git push origin main

# Update the PR branch (merge base into head)
exec gh pr update-branch $PR_URL

# Verify the PR is still open
exec gh pr view $PR_URL
stdout 'state:\tOPEN$'

-- feature.txt --
Feature content
-- base-change.txt --
Base branch change
