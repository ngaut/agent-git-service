# Use gh as a credential helper
exec gh auth setup-git

# Create a repository with a file so it has a default branch
exec gh repo create $ORG/$SCRIPT_NAME-$RANDOM_STRING --add-readme --private

# Defer repo cleanup
defer gh repo delete --yes $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Clone the repo
exec gh repo clone $ORG/$SCRIPT_NAME-$RANDOM_STRING
cd $SCRIPT_NAME-$RANDOM_STRING
exec git config user.email "test@example.com"
exec git config user.name "Test User"

# Create a branch with a change
exec git checkout -b feature-to-revert
mv ../change.txt change.txt
exec git add .
exec git commit -m 'Add change to revert'
exec git push -u origin feature-to-revert

# Create and merge a PR
exec gh pr create --title 'Feature to revert' --body 'This will be reverted'
stdout2env PR_URL
exec gh pr merge $PR_URL --merge

# Verify the PR is merged
exec gh pr view $PR_URL
stdout 'state:\tMERGED$'

# Revert the merged PR
exec gh pr revert $PR_URL --title 'Revert feature' --body 'Reverting the change'

-- change.txt --
This change will be reverted
