# Create a repo for the test
exec gh repo create $ORG/$SCRIPT_NAME-$RANDOM_STRING --add-readme --private
defer gh repo delete --yes $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Create an issue
exec gh issue create --title 'Delete Test' --body 'Body' -R $ORG/$SCRIPT_NAME-$RANDOM_STRING
stdout2env ISSUE_URL

# Verify it exists
exec gh issue view $ISSUE_URL
stdout 'title:\tDelete Test'

# Delete the issue
exec gh issue delete $ISSUE_URL --yes
