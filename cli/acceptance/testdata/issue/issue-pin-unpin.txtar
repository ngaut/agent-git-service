# Create a repo for the test
exec gh repo create $ORG/$SCRIPT_NAME-$RANDOM_STRING --add-readme --private
defer gh repo delete --yes $ORG/$SCRIPT_NAME-$RANDOM_STRING

# Create an issue
exec gh issue create --title 'Pin Test' --body 'Body' -R $ORG/$SCRIPT_NAME-$RANDOM_STRING
stdout2env ISSUE_URL

# Pin the issue
exec gh issue pin $ISSUE_URL

# Unpin the issue
exec gh issue unpin $ISSUE_URL
